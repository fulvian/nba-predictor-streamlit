# API Keys & Configuration
PROPHECY_API_KEY=your_prophecy_key_here
# RAPID_API_KEY=removed_in_favor_of_free_sources

# Database & Paths
DATA_PATH=data
MODEL_PATH=models

# Feature Flags
ENABLE_ADVANCED_STATS=true
ENABLE_NEWS_INTEGRATION=true
ENABLE_NANOGPT_CONSENSUS=true

# News Integration
# Comma-separated list of RSS feeds
RSS_FEED_URLS=https://www.espn.com/espn/rss/nba/news,https://sports.yahoo.com/nba/rss.xml

# NanoGPT Consensus Configuration (MCP Stdio)
# Command to launch the consensus server. Examples:
# - uvx nanogpt-consensus
# - python /path/to/server.py
NANOGPT_CONSENSUS_COMMAND=uvx
# Arguments for the command (JSON list string)
NANOGPT_CONSENSUS_ARGS=["nanogpt-consensus"]
# Timeout for consensus queries in seconds
NANOGPT_TIMEOUT=60
