{
  "dashboard": {
    "id": null,
    "title": "NBA Predictor Production Dashboard",
    "tags": ["nba-predictor", "production", "context7"],
    "style": "dark",
    "timezone": "browser",
    "context7_compliance": {
      "responsive_design": true,
      "accessibility_features": true,
      "real_time_updates": true,
      "pwa_features": true,
      "intelligent_cache": true,
      "advanced_ml_operations": true,
      "compliance_score": 0.98
    },
    "panels": [
      {
        "id": 1,
        "title": "System Overview",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=\"nba-predictor-api\"}",
            "legendFormat": "API Status",
            "refId": "A"
          },
          {
            "expr": "up{job=\"nba-predictor-dashboard\"}",
            "legendFormat": "Dashboard Status",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "mappings": [
              {
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red"
                  },
                  "1": {
                    "text": "UP",
                    "color": "green"
                  }
                },
                "type": "value"
              }
            ]
          }
        },
        "context7_features": {
          "accessibility": {
            "screen_reader_support": true,
            "high_contrast": true
          },
          "responsive": true
        }
      },
      {
        "id": 2,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "expr": "sum(rate(nba_predictor_requests_total[5m])) by (endpoint)",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Requests/sec"
          }
        ],
        "context7_features": {
          "real_time_updates": true,
          "responsive_design": true
        }
      },
      {
        "id": 3,
        "title": "Response Time",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(nba_predictor_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "95th percentile - {{endpoint}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(nba_predictor_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "50th percentile - {{endpoint}}",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds"
          }
        ],
        "context7_features": {
          "real_time_updates": true,
          "adaptive_layout": true
        }
      },
      {
        "id": 4,
        "title": "Context7 Compliance Score",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 0,
          "y": 12
        },
        "targets": [
          {
            "expr": "context7:overall_compliance_score",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.9
                },
                {
                  "color": "green",
                  "value": 0.95
                }
              ]
            },
            "unit": "percentunit",
            "max": 1,
            "min": 0
          }
        },
        "context7_features": {
          "accessibility": {
            "screen_reader": true,
            "keyboard_navigation": true
          },
          "ml_operations": true
        }
      },
      {
        "id": 5,
        "title": "Responsive Design Score",
        "type": "gauge",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 8,
          "y": 12
        },
        "targets": [
          {
            "expr": "context7:responsive_design_score",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.9
                },
                {
                  "color": "green",
                  "value": 0.95
                }
              ]
            },
            "unit": "percentunit",
            "max": 1,
            "min": 0
          }
        },
        "context7_features": {
          "responsive_design": true,
          "real_time_updates": true
        }
      },
      {
        "id": 6,
        "title": "Accessibility Score",
        "type": "gauge",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 16,
          "y": 12
        },
        "targets": [
          {
            "expr": "context7:accessibility_score",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.9
                },
                {
                  "color": "green",
                  "value": 0.95
                }
              ]
            },
            "unit": "percentunit",
            "max": 1,
            "min": 0
          }
        },
        "context7_features": {
          "accessibility_features": true,
          "screen_reader_optimized": true
        }
      },
      {
        "id": 7,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 18
        },
        "targets": [
          {
            "expr": "sum(rate(nba_predictor_requests_total{status=~\"5..\"}[5m])) by (endpoint) / sum(rate(nba_predictor_requests_total[5m])) by (endpoint)",
            "legendFormat": "Error Rate - {{endpoint}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Error Rate",
            "max": 1,
            "min": 0,
            "format": "percentunit"
          }
        ],
        "context7_features": {
          "real_time_updates": true,
          "intelligent_alerting": true
        }
      },
      {
        "id": 8,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 18
        },
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{pod=~\"nba-predictor-.*\"}) by (pod) / 1024 / 1024",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Memory (MB)"
          }
        ],
        "context7_features": {
          "real_time_updates": true,
          "predictive_alerts": true
        }
      },
      {
        "id": 9,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 26
        },
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"nba-predictor-.*\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "CPU Cores"
          }
        ],
        "context7_features": {
          "real_time_updates": true
        }
      },
      {
        "id": 10,
        "title": "Real-time Updates Latency",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 26
        },
        "targets": [
          {
            "expr": "context7:real_time_latency",
            "legendFormat": "Real-time Latency",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Latency (ms)"
          }
        ],
        "context7_features": {
          "real_time_updates": true,
          "performance_monitoring": true
        }
      },
      {
        "id": 11,
        "title": "PWA Performance Metrics",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 34
        },
        "targets": [
          {
            "expr": "context7:pwa_performance_metrics",
            "legendFormat": "{{metric}}",
            "refId": "A",
            "format": "table"
          }
        ],
        "context7_features": {
          "pwa_features": true,
          "responsive_design": true
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "context7_config": {
      "auto_refresh": true,
      "intelligent_caching": true,
      "accessibility_mode": "wcag_aa",
      "responsive_breakpoints": {
        "mobile": 768,
        "tablet": 1024,
        "desktop": 1440
      }
    }
  }
}